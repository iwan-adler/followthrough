# --- LLM (free tier only). Leave LLM_API_KEY empty to use the deterministic mock. ---
# LLM_PROVIDER: gemini | groq
LLM_PROVIDER=gemini
LLM_API_KEY=
# Defaults: gemini -> gemini-2.5-flash, groq -> llama-3.3-70b-versatile
LLM_MODEL=
LLM_MAX_RETRIES=3

# --- Tracker (GitHub Issues). Leave empty to use the local mock tracker. ---
GITHUB_TOKEN=
# owner/repo
GITHUB_REPO=

# --- App ---
DB_PATH=followthrough.db
# Minutes between background reminder sweeps
REMINDER_INTERVAL_MINUTES=15
