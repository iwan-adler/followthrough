# --- LLM (free tier only). Leave LLM_API_KEY empty to use the deterministic mock. ---
# LLM_PROVIDER: gemini | groq
LLM_PROVIDER=gemini
LLM_API_KEY=
# Optional: model to try first. Otherwise a built-in chain is used (see app/llm.py):
# busy (503/429) models hand over to the next one, retired (404) models are skipped.
LLM_MODEL=
# Optional: comma-separated replacement for the built-in fallback chain
LLM_FALLBACK_MODELS=
LLM_MAX_RETRIES=3
# Reuse answers for identical prompts (makes demo reloads instant). Set false to always call the model.
LLM_CACHE=true

# --- Tracker (GitHub Issues). Leave empty to use the local mock tracker. ---
GITHUB_TOKEN=
# owner/repo
GITHUB_REPO=
# Optional: map meeting names to GitHub logins for assignees, e.g. Priya=priya-gh,Raj=rajdev
GITHUB_USER_MAP=

# --- App ---
DB_PATH=followthrough.db
# Minutes between background reminder sweeps
REMINDER_INTERVAL_MINUTES=15
# Set to false to disable the background reminder scheduler
SCHEDULER_ENABLED=true
